    {
      "name": "realistic_stress_test",
      "tests": [
        {
          "function": "parse",
          "expect": [
            {
              "key": "name",
              "value": "Dmitrii Kovanikov"
            },
            {
              "key": "login",
              "value": "chshersh"
            },
            {
              "key": "language",
              "value": "OCaml"
            },
            {
              "key": "date",
