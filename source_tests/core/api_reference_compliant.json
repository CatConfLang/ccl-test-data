{
  "$schema": "../../schemas/source-format.json",
  "tests": [
    {
      "behaviors": [
        "list_coercion_disabled"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "item = single"
      ],
      "name": "single_item_as_list_reference",
      "tests": [
        {
          "expect": [
            {
              "key": "item",
              "value": "single"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "item": "single"
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "item": {
              "single": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "item"
          ],
          "expect": null,
          "function": "get_list"
        }
      ],
      "variants": [
        "reference_compliant"
      ]
    },
