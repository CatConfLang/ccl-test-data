        },
        {
          "function": "parse",
          "expect": [
            {
              "key": "safe",
              "value": "value"
            }
          ]
        },
        {
          "function": "build_hierarchy",
          "expect": {
            "safe": "value"
          }
        }
      ],
      "behaviors": [
        "list_coercion_disabled"
      ],
      "variants": [
