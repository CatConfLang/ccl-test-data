    {
      "name": "list_with_whitespace_reference",
      "tests": [
        {
          "function": "parse",
          "expect": [
            {
              "key": "items",
              "value": "spaced"
            },
            {
              "key": "items",
              "value": "normal"
            },
            {
              "key": "items",
              "value": ""
            },
            {
              "key": "items",
              "value": ""
            }
          ]
        },
        {
          "function": "build_hierarchy",
          "expect": {
            "items": [
              "",
              "",
              "normal",
              "spaced"
            ]
          }
        },
        {
          "function": "get_list",
          "expect": null,
          "args": [
            "items"
          ]
        }
      ],
