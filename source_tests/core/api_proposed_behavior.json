{
  "$schema": "../../schemas/source-format.json",
  "tests": [
    {
      "behaviors": [
        "multiline_values"
      ],
      "features": [
        "empty_keys",
        "multiline_continuation"
      ],
      "functions": [
        "parse_indented"
      ],
      "inputs": [
        "== Section Header =\n  This continues the header\nkey = value"
      ],
      "name": "multiline_section_header_value",
      "tests": [
        {
          "expect": [
            {
              "key": "",
              "value": "= Section Header =\n  This continues the header"
            },
            {
              "key": "key",
              "value": "value"
            }
          ],
          "function": "parse_indented"
        }
      ]
    },
    {
      "features": [
        "empty_keys",
        "multiline_keys"
      ],
      "functions": [
        "parse",
        "parse_indented"
      ],
      "inputs": [
        "== Section Header =\nprefix for next key\nkey = value"
      ],
      "name": "unindented_line_does_not_continue_value",
      "tests": [
        {
          "expect": [
            {
              "key": "",
              "value": "= Section Header ="
            },
            {
              "key": "prefix for next key\nkey",
              "value": "value"
            }
          ],
          "function": "parse"
        },
        {
          "expect": [
            {
              "key": "",
              "value": "= Section Header ="
            },
            {
              "key": "prefix for next key\nkey",
              "value": "value"
            }
          ],
          "function": "parse_indented"
        }
      ],
      "variants": [
        "reference_compliant"
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion",
        "multiline_values"
      ],
      "features": [
        "multiline_continuation"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse_indented"
      ],
      "inputs": [
        "descriptions = First line\n  second line\ndescriptions = Another item"
      ],
      "name": "indented_line_is_continuation",
      "tests": [
        {
          "expect": [
            {
              "key": "descriptions",
              "value": "First line\n  second line"
            },
            {
              "key": "descriptions",
              "value": "Another item"
            }
          ],
          "function": "parse_indented"
        },
        {
          "expect": {
            "descriptions": [
              "First line\n  second line",
              "Another item"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "descriptions": {
              "Another item": {},
              "First line\n  second line": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "descriptions"
          ],
          "expect": [
            "First line\n  second line",
            "Another item"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "item = single"
      ],
      "name": "single_item_as_list",
      "tests": [
        {
          "expect": [
            {
              "key": "item",
              "value": "single"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "item": "single"
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "item": {
              "single": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "item"
          ],
          "expect": [
            "single"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "ports = 80\nports = 443\nhost = localhost"
      ],
      "name": "mixed_duplicate_single_keys",
      "tests": [
        {
          "expect": [
            {
              "key": "ports",
              "value": "80"
            },
            {
              "key": "ports",
              "value": "443"
            },
            {
              "key": "host",
              "value": "localhost"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "host": "localhost",
            "ports": [
              "80",
              "443"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "host": {
              "localhost": {}
            },
            "ports": {
              "443": {},
              "80": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "ports"
          ],
          "expect": [
            "80",
            "443"
          ],
          "function": "get_list"
        },
        {
          "args": [
            "host"
          ],
          "expect": [
            "localhost"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "path_traversal"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "database =\n  hosts = primary\n  hosts = secondary\n  port = 5432"
      ],
      "name": "nested_list_access",
      "tests": [
        {
          "expect": [
            {
              "key": "database",
              "value": "\n  hosts = primary\n  hosts = secondary\n  port = 5432"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "database": {
              "hosts": [
                "primary",
                "secondary"
              ],
              "port": "5432"
            }
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "database": {
              "hosts": {
                "primary": {},
                "secondary": {}
              },
              "port": {
                "5432": {}
              }
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "database",
            "hosts"
          ],
          "expect": [
            "primary",
            "secondary"
          ],
          "function": "get_list"
        },
        {
          "args": [
            "database",
            "port"
          ],
          "expect": [
            "5432"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "empty_list ="
      ],
      "name": "empty_list",
      "tests": [
        {
          "expect": [
            {
              "key": "empty_list",
              "value": ""
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "empty_list": ""
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "empty_list": {
              "": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "empty_list"
          ],
          "expect": [
            ""
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "numbers = 1\nnumbers = 42\nnumbers = -17\nnumbers = 0"
      ],
      "name": "list_with_numbers",
      "tests": [
        {
          "expect": [
            {
              "key": "numbers",
              "value": "1"
            },
            {
              "key": "numbers",
              "value": "42"
            },
            {
              "key": "numbers",
              "value": "-17"
            },
            {
              "key": "numbers",
              "value": "0"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "numbers": [
              "1",
              "42",
              "-17",
              "0"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "numbers": {
              "-17": {},
              "0": {},
              "1": {},
              "42": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "numbers"
          ],
          "expect": [
            "1",
            "42",
            "-17",
            "0"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "flags = true\nflags = false\nflags = yes\nflags = no"
      ],
      "name": "list_with_booleans",
      "tests": [
        {
          "expect": [
            {
              "key": "flags",
              "value": "true"
            },
            {
              "key": "flags",
              "value": "false"
            },
            {
              "key": "flags",
              "value": "yes"
            },
            {
              "key": "flags",
              "value": "no"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "flags": [
              "true",
              "false",
              "yes",
              "no"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "flags": {
              "false": {},
              "no": {},
              "true": {},
              "yes": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "flags"
          ],
          "expect": [
            "true",
            "false",
            "yes",
            "no"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "features": [
        "whitespace"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "items =   spaced   \nitems = normal\nitems =\nitems =   "
      ],
      "name": "list_with_whitespace",
      "tests": [
        {
          "expect": [
            {
              "key": "items",
              "value": "spaced"
            },
            {
              "key": "items",
              "value": "normal"
            },
            {
              "key": "items",
              "value": ""
            },
            {
              "key": "items",
              "value": ""
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "items": [
              "spaced",
              "normal",
              "",
              ""
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "items": {
              "": {},
              "normal": {},
              "spaced": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "items"
          ],
          "expect": [
            "spaced",
            "normal",
            "",
            ""
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "features": [
        "unicode"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "names = 张三\nnames = José\nnames = François\nnames = العربية"
      ],
      "name": "list_with_unicode",
      "tests": [
        {
          "expect": [
            {
              "key": "names",
              "value": "张三"
            },
            {
              "key": "names",
              "value": "José"
            },
            {
              "key": "names",
              "value": "François"
            },
            {
              "key": "names",
              "value": "العربية"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "names": [
              "张三",
              "José",
              "François",
              "العربية"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "names": {
              "François": {},
              "José": {},
              "العربية": {},
              "张三": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "names"
          ],
          "expect": [
            "张三",
            "José",
            "François",
            "العربية"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "symbols = @#$%\nsymbols = !^\u0026*()\nsymbols = []{}|\nsymbols = \u003c\u003e=+"
      ],
      "name": "list_with_special_characters",
      "tests": [
        {
          "expect": [
            {
              "key": "symbols",
              "value": "@#$%"
            },
            {
              "key": "symbols",
              "value": "!^\u0026*()"
            },
            {
              "key": "symbols",
              "value": "[]{}|"
            },
            {
              "key": "symbols",
              "value": "\u003c\u003e=+"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "symbols": [
              "@#$%",
              "!^\u0026*()",
              "[]{}|",
              "\u003c\u003e=+"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "symbols": {
              "!^\u0026*()": {},
              "\u003c\u003e=+": {},
              "@#$%": {},
              "[]{}|": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "symbols"
          ],
          "expect": [
            "@#$%",
            "!^\u0026*()",
            "[]{}|",
            "\u003c\u003e=+"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion",
        "multiline_values"
      ],
      "features": [
        "multiline_continuation"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse_indented"
      ],
      "inputs": [
        "descriptions = First line\nsecond line\ndescriptions = Another item\ndescriptions = Third item"
      ],
      "name": "list_multiline_values",
      "tests": [
        {
          "expect": {
            "descriptions": [
              "First line",
              "Another item",
              "Third item"
            ],
            "second line": ""
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "descriptions": {
              "Another item": {},
              "First line": {},
              "Third item": {}
            },
            "second line": {
              "": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "descriptions"
          ],
          "expect": [
            "First line",
            "Another item",
            "Third item"
          ],
          "function": "get_list"
        },
        {
          "expect": [
            {
              "key": "descriptions",
              "value": "First line"
            },
            {
              "key": "second line",
              "value": ""
            },
            {
              "key": "descriptions",
              "value": "Another item"
            },
            {
              "key": "descriptions",
              "value": "Third item"
            }
          ],
          "function": "parse_indented"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled",
        "array_order_insertion",
        "path_traversal"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse_indented"
      ],
      "inputs": [
        "config =\n  servers = web1\n  servers = web2\n  database =\n    hosts = primary\n    hosts = backup\n    port = 5432\n  cache = redis\nfeatures = auth\nfeatures = api\nfeatures = ui"
      ],
      "name": "complex_mixed_list_scenarios",
      "tests": [
        {
          "args": [
            "config",
            "servers"
          ],
          "expect": [
            "web1",
            "web2"
          ],
          "function": "get_list"
        },
        {
          "args": [
            "config",
            "database",
            "hosts"
          ],
          "expect": [
            "primary",
            "backup"
          ],
          "function": "get_list"
        },
        {
          "args": [
            "config",
            "cache"
          ],
          "expect": [
            "redis"
          ],
          "function": "get_list"
        },
        {
          "args": [
            "features"
          ],
          "expect": [
            "auth",
            "api",
            "ui"
          ],
          "function": "get_list"
        },
        {
          "expect": [
            {
              "key": "config",
              "value": "\n  servers = web1\n  servers = web2\n  database =\n    hosts = primary\n    hosts = backup\n    port = 5432\n  cache = redis"
            },
            {
              "key": "features",
              "value": "auth"
            },
            {
              "key": "features",
              "value": "api"
            },
            {
              "key": "features",
              "value": "ui"
            }
          ],
          "function": "parse_indented"
        },
        {
          "expect": {
            "config": {
              "cache": "redis",
              "database": {
                "hosts": [
                  "primary",
                  "backup"
                ],
                "port": "5432"
              },
              "servers": [
                "web1",
                "web2"
              ]
            },
            "features": [
              "auth",
              "api",
              "ui"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "config": {
              "cache": {
                "redis": {}
              },
              "database": {
                "hosts": {
                  "backup": {},
                  "primary": {}
                },
                "port": {
                  "5432": {}
                }
              },
              "servers": {
                "web1": {},
                "web2": {}
              }
            },
            "features": {
              "api": {},
              "auth": {},
              "ui": {}
            }
          },
          "function": "build_model"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_enabled"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "safe = value"
      ],
      "name": "list_path_traversal_protection",
      "tests": [
        {
          "expect": [
            {
              "key": "safe",
              "value": "value"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "safe": "value"
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "safe": {
              "value": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            ""
          ],
          "expect": null,
          "function": "get_list"
        },
        {
          "expect": null,
          "function": "get_list"
        },
        {
          "args": [
            "safe"
          ],
          "expect": [
            "value"
          ],
          "function": "get_list"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_string",
        "parse"
      ],
      "inputs": [
        "empty_key ="
      ],
      "name": "parse_empty_value",
      "tests": [
        {
          "expect": {
            "empty_key": ""
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "empty_key": {
              "": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "empty_key"
          ],
          "expect": "",
          "function": "get_string"
        },
        {
          "expect": [
            {
              "key": "empty_key",
              "value": ""
            }
          ],
          "function": "parse"
        }
      ]
    }
  ]
}
