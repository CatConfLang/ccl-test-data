      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "servers = web1\nservers = web2\nservers = web3"
      ],
      "name": "basic_list_from_duplicates",
      "tests": [
        {
          "expect": [
            {
              "key": "servers",
              "value": "web1"
            },
            {
              "key": "servers",
              "value": "web2"
            },
            {
              "key": "servers",
              "value": "web3"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "servers": [
              "web1",
              "web2",
              "web3"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "servers": {
              "web1": {},
              "web2": {},
              "web3": {}
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "servers"
          ],
          "expect": [
            "web1",
            "web2",
            "web3"
          ],
          "function": "get_list"
        }
      ]
    },
