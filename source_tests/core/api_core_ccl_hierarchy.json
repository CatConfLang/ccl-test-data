{
  "$schema": "../../schemas/source-format.json",
  "tests": [
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "load",
        "parse",
        "print"
      ],
      "inputs": [
        "name = Alice\nage = 42"
      ],
      "name": "basic_object_construction",
      "tests": [
        {
          "expect": [
            {
              "key": "name",
              "value": "Alice"
            },
            {
              "key": "age",
              "value": "42"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "name = Alice\nage = 42",
          "function": "print"
        },
        {
          "expect": {
            "age": "42",
            "name": "Alice"
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "age": {
              "42": {}
            },
            "name": {
              "Alice": {}
            }
          },
          "function": "build_model"
        },
        {
          "expect": {
            "age": "42",
            "name": "Alice"
          },
          "function": "load"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "load",
        "parse",
        "print"
      ],
      "inputs": [
        "server =\n  database =\n    host = localhost\n    port = 5432\n  cache =\n    enabled = true"
      ],
      "name": "deep_nested_objects",
      "tests": [
        {
          "expect": [
            {
              "key": "server",
              "value": "\n  database =\n    host = localhost\n    port = 5432\n  cache =\n    enabled = true"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "server =\n  database =\n    host = localhost\n    port = 5432\n  cache =\n    enabled = true",
          "function": "print"
        },
        {
          "expect": {
            "server": {
              "cache": {
                "enabled": "true"
              },
              "database": {
                "host": "localhost",
                "port": "5432"
              }
            }
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "server": {
              "cache": {
                "enabled": {
                  "true": {}
                }
              },
              "database": {
                "host": {
                  "localhost": {}
                },
                "port": {
                  "5432": {}
                }
              }
            }
          },
          "function": "build_model"
        },
        {
          "expect": {
            "server": {
              "cache": {
                "enabled": "true"
              },
              "database": {
                "host": "localhost",
                "port": "5432"
              }
            }
          },
          "function": "load"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "load",
        "parse",
        "print"
      ],
      "inputs": [
        "item = first\nitem = second\nitem = third"
      ],
      "name": "duplicate_keys_to_lists",
      "tests": [
        {
          "expect": [
            {
              "key": "item",
              "value": "first"
            },
            {
              "key": "item",
              "value": "second"
            },
            {
              "key": "item",
              "value": "third"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "item = first\nitem = second\nitem = third",
          "function": "print"
        },
        {
          "expect": {
            "item": [
              "first",
              "second",
              "third"
            ]
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "item": {
              "first": {},
              "second": {},
              "third": {}
            }
          },
          "function": "build_model"
        },
        {
          "expect": {
            "item": [
              "first",
              "second",
              "third"
            ]
          },
          "function": "load"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "parse",
        "print"
      ],
      "inputs": [
        "config =\n  server = web1\n  server = web2\n  port = 80"
      ],
      "name": "nested_duplicate_keys",
      "tests": [
        {
          "expect": [
            {
              "key": "config",
              "value": "\n  server = web1\n  server = web2\n  port = 80"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "config =\n  server = web1\n  server = web2\n  port = 80",
          "function": "print"
        },
        {
          "expect": {
            "config": {
              "port": "80",
              "server": [
                "web1",
                "web2"
              ]
            }
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "config": {
              "port": {
                "80": {}
              },
              "server": {
                "web1": {},
                "web2": {}
              }
            }
          },
          "function": "build_model"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "parse",
        "print"
      ],
      "inputs": [
        "name = Alice\nconfig =\n  debug = true\n  timeout = 30\nversion = 1.0"
      ],
      "name": "mixed_flat_and_nested",
      "tests": [
        {
          "expect": [
            {
              "key": "name",
              "value": "Alice"
            },
            {
              "key": "config",
              "value": "\n  debug = true\n  timeout = 30"
            },
            {
              "key": "version",
              "value": "1.0"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "name = Alice\nconfig =\n  debug = true\n  timeout = 30\nversion = 1.0",
          "function": "print"
        },
        {
          "expect": {
            "config": {
              "debug": "true",
              "timeout": "30"
            },
            "name": "Alice",
            "version": "1.0"
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "config": {
              "debug": {
                "true": {}
              },
              "timeout": {
                "30": {}
              }
            },
            "name": {
              "Alice": {}
            },
            "version": {
              "1.0": {}
            }
          },
          "function": "build_model"
        }
      ]
    },
    {
      "functions": [
        "build_hierarchy",
        "build_model",
        "parse",
        "print"
      ],
      "inputs": [
        "environments =\n  prod =\n    server = web1\n    server = web2\n    port = 80\n  dev =\n    server = localhost\n    port = 3000"
      ],
      "name": "nested_objects_with_lists",
      "tests": [
        {
          "expect": [
            {
              "key": "environments",
              "value": "\n  prod =\n    server = web1\n    server = web2\n    port = 80\n  dev =\n    server = localhost\n    port = 3000"
            }
          ],
          "function": "parse"
        },
        {
          "expect": "environments =\n  prod =\n    server = web1\n    server = web2\n    port = 80\n  dev =\n    server = localhost\n    port = 3000",
          "function": "print"
        },
        {
          "expect": {
            "environments": {
              "dev": {
                "port": "3000",
                "server": "localhost"
              },
              "prod": {
                "port": "80",
                "server": [
                  "web1",
                  "web2"
                ]
              }
            }
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "environments": {
              "dev": {
                "port": {
                  "3000": {}
                },
                "server": {
                  "localhost": {}
                }
              },
              "prod": {
                "port": {
                  "80": {}
                },
                "server": {
                  "web1": {},
                  "web2": {}
                }
              }
            }
          },
          "function": "build_model"
        }
      ]
    },
    {
      "behaviors": [
        "list_coercion_disabled",
        "array_order_lexicographic",
        "path_traversal"
      ],
      "functions": [
        "build_hierarchy",
        "build_model",
        "get_list",
        "parse"
      ],
      "inputs": [
        "config =\n  environments =\n    production =\n      servers = web1\n      servers = web2\n      servers = api1"
      ],
      "name": "deeply_nested_list",
      "tests": [
        {
          "expect": [
            {
              "key": "config",
              "value": "\n  environments =\n    production =\n      servers = web1\n      servers = web2\n      servers = api1"
            }
          ],
          "function": "parse"
        },
        {
          "expect": {
            "config": {
              "environments": {
                "production": {
                  "servers": [
                    "api1",
                    "web1",
                    "web2"
                  ]
                }
              }
            }
          },
          "function": "build_hierarchy"
        },
        {
          "expect": {
            "config": {
              "environments": {
                "production": {
                  "servers": {
                    "api1": {},
                    "web1": {},
                    "web2": {}
                  }
                }
              }
            }
          },
          "function": "build_model"
        },
        {
          "args": [
            "config",
            "environments",
            "production",
            "servers"
          ],
          "expect": null,
          "function": "get_list"
        }
      ]
    }
  ]
}
