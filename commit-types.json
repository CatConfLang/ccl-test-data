{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Single source of truth for conventional commit types used by commitlint",
  "types": {
    "feat": {
      "description": "A new feature",
      "changelog_group": "Features",
      "scope_required": true
    },
    "fix": {
      "description": "A bug fix",
      "changelog_group": "Bug Fixes",
      "scope_required": true
    },
    "perf": {
      "description": "A code change that improves performance",
      "changelog_group": "Performance",
      "scope_required": true
    },
    "refactor": {
      "description": "A code change that neither fixes a bug nor adds a feature",
      "changelog_group": null,
      "scope_required": true
    },
    "test": {
      "description": "Adding missing tests or correcting existing tests",
      "changelog_group": null,
      "scope_required": true
    },
    "revert": {
      "description": "Reverts a previous commit",
      "changelog_group": null,
      "scope_required": true
    },
    "style": {
      "description": "Changes that do not affect the meaning of the code",
      "changelog_group": null,
      "scope_required": true
    },
    "docs": {
      "description": "Documentation only changes",
      "changelog_group": null,
      "scope_required": false
    },
    "chore": {
      "description": "Other changes that don't modify src or test files",
      "changelog_group": null,
      "scope_required": false
    },
    "build": {
      "description": "Changes that affect the build system or external dependencies",
      "changelog_group": null,
      "scope_required": false
    },
    "ci": {
      "description": "Changes to CI configuration files and scripts",
      "changelog_group": null,
      "scope_required": false
    }
  },
  "scopes": {
    "schema": {
      "display_name": "Schema",
      "in_changelog": true
    },
    "tests": {
      "display_name": "Tests",
      "in_changelog": true
    },
    "test-reader": {
      "display_name": "Test Reader",
      "in_changelog": true
    },
    "cli": {
      "display_name": "CLI",
      "in_changelog": true
    },
    "generation": {
      "display_name": "Generator",
      "in_changelog": false
    },
    "config": {
      "display_name": "Configuration",
      "in_changelog": false
    },
    "build": {
      "display_name": "Build",
      "in_changelog": false
    },
    "release": {
      "display_name": "Release",
      "in_changelog": false
    }
  },
  "changelog_scope_order": ["tests", "schema", "test-reader", "cli"],
  "commitlint_rules": {
    "subject-case": [2, "never", ["upper-case"]],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "header-max-length": [2, "always", 100]
  }
}
